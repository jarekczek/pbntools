+/** @page pcard2 PCard2 - playing card symbology description
+ * @section pcard2_std PCard2 standard characteristics (WIN)
+ * @par
+ * A barcode consists of 4 bars. The widths are 1 or 2 units, the same with white bars.
+ * A cummulative length of barcode is 12 or 13 units.
+ * There are no border bars, so even edge bars may be 2 units wide.
+ * @par
+ * Unfortunately the symbols are oriented. That means there are cards that have mirror codes.
+ * An example of that are H2 (1121221) and ST (1221211).
+ * That breaks the rule of zbar which usually reads barcodes in four
+ * possible orientations: up, right, down and left. I decided to choose only one orientation (up) to avoid problems of mistaking
+ * 2 and 5 of spades. The checking is done in symbol_handler(). It is after the symbol was detected, because there is no way to tell the orientation of the scanner before.
+ * If the symbol was scanned in a different orientation, it is omitted.
+ * @par
+ * The algorithm works as follows:
+ * <ol>
+ *   <li>Locate the barcode between quite zones, then calls pcard2_decode_inside.
+ *   <li>Iterate through all the symbols and try to match one by one</li>
+ *   <ol>
+ *     <li>Determine the unit width by getting the sum of the first 2 bars and divide it by the expected width
+ *         for that symbol (2, 3 or 4)</li>
+ *     <li>Iterate through the bars to verify sum2 values (method verify_sum2).
+ *         Use is_almost_equal method. Break if the lengths don't match the expected values.
+ *     </li>
+ *     <li>Iterate through the black bars to verify their width (method verify_black).
+ *         Accomodate for possible glow effect, which may reduce the width
+ *         by up to 1/2 (configuration pcard2.glow_width) unit width.</li>
+ *     <li>If the symbol matches, break.</li>
+ *   </ol>
+ * </ol>
+ * @par
+ * The PCard2 symbology has no checking mechanisms. When the dealing machine reads a card it knows exactly where the code is, so there's
+ * little probability of a mistake. We are in worse situation, as we try to locate the symbol anywhere on the picture.
+ * It turned out that zbar was able to detect pcard2 symbols in surprising places with no barcodes at all.
+ * To distinguish the real symbol from some random spots I decided to use the <i>uncertainty</i> feature. The uncertainty for PCard2 is set to 6 in zbar_image_scanner_create().
+ * This works in zbarcam. For discarding noise in zbarimg the minimal quality filter in zbar_scan_image() is used.
+ * @section pcard2_output Output format
+ * @par
+ * The output of zbar when it recognizes PCard2 follows the following template: <em>PCard2:XY</em>. <em>XY</em> denotes the card read,
+ * where <em>X</em> is the color and <em>Y</em> is the rank of the card.
+ * Colors are represented by letters S, H, D, C, respectively: spades, hearts, diamonds, clubs. Rank is one of A, K, Q, J, T, 9, 8, ..., 3, 2.
+ * For example C5 denotes the card 5 of clubs. There is a special XY combination for a joker: **. 52 colored cards plus a joker make 53 possibilities.
+ */
+
+#include <config.h>
+#include <zbar.h>
+#include <string.h>
+#include <assert.h>
+
+#ifdef DEBUG_PCARD2
+# define DEBUG_LEVEL (DEBUG_PCARD2)
+#endif
+#include "../debug.h"
+#include "../decoder.h"
+#include "pcard2_defs.h"
+
+static const char *card_colors = "CDHS";
+
+///\brief get string representation of this int_code - 2 characters
+static void get_string_code2(int int_code, unsigned char *buffer) {
+    if (int_code % 0x0100 == '*') {
+        buffer[0] = '*';
+        buffer[1] = '*';
+    } else {
+        buffer[0] = card_colors[int_code / 0x0100];
+        buffer[1] = (char)(int_code % 0x0100);
+    }
+    buffer[2] = 0;
+}
+
+///\brief check whether x is equal x0 with a tolerance of toler % relative to x0
+static inline int is_almost_equal (int x, int x0, int toler)
+{
+    return (100*x < (100+toler)*x0) && (100*x > (100-toler)*x0);
+}
+
+static int verify_sum2 (zbar_decoder_t *dcode, int bar_count,
+                        const char *code_sum2, int unit_width, int toler)
+{
+    int i;
+    for (i = 1; i < 6; i++) {
+        int w_sum2 = get_width(dcode, bar_count - 1 - i) +
+                     get_width(dcode, bar_count - 2 - i);
+        int expected = (code_sum2[i] - '0') * unit_width;
+        if (!is_almost_equal(w_sum2, expected, toler))
+            return 0;
+    }
+    return 1;
+}
+
+static int verify_black (zbar_decoder_t *dcode, int bar_count,
+                         const char *code12, int unit_width, int toler, int glow_perc)
+{
+    int i;
+    for (i = 0; i < 7; i += 2) {
+        int w = get_width(dcode, bar_count - 1 - i);
+        int expected = (code12[i] - '0') * unit_width;
+        // The bar can be thinner due to glow, but not thicker (except for tolerance).
+        // Width range: [expected - glow, expected]
+        int glow = unit_width * glow_perc; // scaled by 100
+        int w100 = 100 * w;
+        int exp100 = 100 * expected;
+        int t = exp100 * toler / 100;
+
+        if (w100 > exp100 + t || w100 < exp100 - glow - t)
+            return 0;
+    }
+    return 1;
+}
+
+static zbar_symbol_type_t return_symbol (zbar_decoder_t *dcode, int int_code,
+                                      int bar_count)
+{
+    if(acquire_lock(dcode, ZBAR_PCARD2)==0) {
+        get_string_code2(int_code, dcode->buf);
+        dcode->buflen = strlen((void*)dcode->buf);
+        dcode->direction = 1;
+        dcode->modifiers = 0;
+
+        //printf("we got symbol %s (", dcode->buf);
+        //for (i=0; i<=bar_count; i++) { printf("%d ", get_width(dcode,i)); }
+        //printf("\n");
+
+        return ZBAR_PCARD2;
+    }
+    else {
+        dbprintf(1, " [locked %d]", dcode->lock);
+        return ZBAR_PARTIAL;
+    }
+}
+
+///\brief try to decode a symbol after quite zones are located
+zbar_symbol_type_t pcard2_decode_inside (zbar_decoder_t *dcode, int bar_count)
+{
+    int int_code = 0; // card value as an index in pcard2_symbol_defs
+    int i;
+    
+    // we have found both left and right silent zones
+    // current position is on the right white margin, get_color()==ZBAR_SPACE
+    
+    // pcard2 requires exactly 7 bars + 1 margin.
+    if (bar_count != 8) //8)
+        return(ZBAR_NONE);
+
+    for (i = 0; i < PCARD2_CODE_COUNT ; i++) {
+        pcard2_symbol_def_t *def = &pcard2_symbol_defs[i];
+        int expected_sum2_0 = def->code_sum2[0] - '0';
+        int unit_width = (get_width(dcode, bar_count - 1) + 
+                               get_width(dcode, bar_count - 2)) / expected_sum2_0;
+        
+        if (verify_sum2(dcode, bar_count, def->code_sum2, unit_width, dcode->pcard2.max_perc_err)
+            && verify_black(dcode, bar_count, def->code12, unit_width, dcode->pcard2.max_perc_err_black, dcode->pcard2.glow_width_perc)
+            ) {
+            // Match found
+            int_code = def->int_code;
+            break;
+        }
+    }
+
+    if (!int_code)
+        return ZBAR_NONE;
+
+    return return_symbol(dcode, int_code, bar_count);
+}
+
+
+zbar_symbol_type_t _zbar_decode_pcard2 (zbar_decoder_t *dcode)
+{
+    int bar_count;
+
+    zbar_symbol_type_t sym = ZBAR_NONE;
+    
+    assert(PCARD2_BIT_COUNT+4 < DECODE_WINDOW);
+
+    if (get_color(dcode)==ZBAR_BAR) {
+        // white is always first, so there' always white before black
+        if (get_width(dcode,1)==0 || get_width(dcode,0) * dcode->pcard2.silent_zone_ratio < get_width(dcode,1)) {
+            // we got a black after big white
+            dcode->pcard2.idx_start = dcode->idx-1;
+            dcode->pcard2.total_width = get_width(dcode,0);            
+            dcode->pcard2.bar_count = 1;
+            sym = ZBAR_PARTIAL;
+        }
+    }  
+
+    if (dcode->pcard2.idx_start>=0 && sym==ZBAR_NONE) {
+        // checking if sym==ZBAR_NONE not to get here right after detecting the left border
+        // we are inside the code, waiting for the right silent zone
+        bar_count = ( dcode->pcard2.bar_count += 1);
+        assert(bar_count>0);
+        if (bar_count > 15) {
+            // we can't get so many bars
+            // max is (big white)+(left black)+(6 whites)+(5 blacks)+(right black)+(big white) = 15
+            //dbprintf(1, "dcode->idx (%d) too many bars %d\n", dcode->idx, bar_count);
+            dcode->pcard2.idx_start = -1;
+        }
+        else if (get_color(dcode)==ZBAR_SPACE &&
+                 (get_width(dcode,0)==0 || get_width(dcode,1) * dcode->pcard2.silent_zone_ratio < get_width(dcode,0))) {
+            // we have another big white - it may be a closing one
+            sym = pcard2_decode_inside(dcode, bar_count);
+            
+            // doesn't matter whether we found the right symbol or not - let's prepare for the next sym
+            dcode->pcard2.idx_start = -1;
+            
+        }
+        
+        if (dcode->pcard2.idx_start >= 0) {
+          // we're still inside
+          dcode->pcard2.total_width += get_width(dcode,0);
+        }
+        
+    }
+    
+    return(sym);
+}
+
+void pcard2_init()
+{
+}
