+#ifndef _PCARD2_H_
+#define _PCARD2_H_
+
+/* PCard2 specific decode state */
+typedef struct pcard2_decoder_s {
+    unsigned silent_zone_ratio; ///< how many times greater should be white space before the first black bar
+    int max_perc_err;           ///< maximal error in bar width [%]
+    int max_perc_err_black;     ///< maximal error in bar width [%] for checking black bars
+    int glow_width_perc;        ///< glow effect width in [%] of unit width
+    int idx_start;              ///< index of left quiet zone, -1 if not detected
+    int total_width;            ///< total width of a symbol
+    int bar_count;
+
+    unsigned config;
+    int configs[NUM_CFGS];      /* int valued configurations */
+} pcard2_decoder_t;
+
+/* reset PCard2 pass specific state */
+static inline void pcard2_new_scan (pcard2_decoder_t *pcard2)
+{
+    pcard2->idx_start = -1;
+    pcard2->bar_count = 0;
+}
+
+/* reset all PCard2 state */
+static inline void pcard2_reset (pcard2_decoder_t *pcard2)
+{
+    pcard2_new_scan(pcard2);
+}
+
+/* decode PCard2 symbols */
+zbar_symbol_type_t _zbar_decode_pcard2(zbar_decoder_t *dcode);
+
+void pcard2_init();
+
+#endif
